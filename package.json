{
  "name": "solomindlm-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.2.2",
  "workspaces": {
    "packages": ["apps/web", "apps/mobile"]
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.2.2"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "scripts": {
    "dev": "bun run --elide-lines=0 --filter \"./apps/**\" dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:mobile": "bun run --cwd apps/mobile dev",
    "run:android": "bun run --cwd apps/mobile run:android",
    "build": "bun run --filter \"./apps/**\" build",
    "build:prod": "bun run --filter @solomindlm/web build",
    "typecheck:convex": "bun x tsgo --noEmit -p convex/tsconfig.json",
    "verify:convex-deps": "node scripts/verify-convex-deps.mjs",
    "typecheck:web": "bun x tsgo --noEmit -p apps/web/tsconfig.json",
    "typecheck:mobile": "bun x tsgo --noEmit -p apps/mobile/tsconfig.json",
    "convex:env:pull": "node scripts/pull-convex-env.mjs",
    "convex:env:pull:dev": "node scripts/pull-convex-env.mjs --dev-only",
    "convex:env:pull:prod": "node scripts/pull-convex-env.mjs --prod-only",
    "convex:env:push": "node scripts/push-convex-env.mjs",
    "convex:env:push:prod": "node scripts/push-convex-env.mjs --prod",
    "convex:env:push:dry": "node scripts/push-convex-env.mjs --dry-run",
    "link:claude-skills": "node scripts/link-claude-skills.js",
    "lint": "biome check . --max-diagnostics=50",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun run test:web && bun run test:convex",
    "test:watch": "bun run --cwd apps/web test:watch",
    "test:web": "bun run --cwd apps/web test",
    "test:web:watch": "bun run --cwd apps/web test:watch",
    "test:web:coverage": "bun run --cwd apps/web test:coverage",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "test:convex:watch": "vitest --config vitest.convex.config.ts",
    "test:integration": "vitest run --config vitest.convex.config.ts --include 'convex/**/*.integration.test.ts'",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "eval:rag": "bun --env-file=.env run evals/rag/cli.ts",
    "eval:rag:dry": "bun run evals/rag/cli.ts --dry-run",
    "eval:rag:smoke": "bun --env-file=.env run evals/rag/cli.ts --split smoke",
    "eval:rag:train": "bun --env-file=.env run evals/rag/cli.ts --split train",
    "eval:rag:train:snapshot": "bun --env-file=.env run evals/rag/cli.ts --split train --export-artifacts --artifacts-dir evals/rag/generated/train-snapshot",
    "eval:rag:judge-queue": "bun --env-file=.env run evals/rag/cli.ts --score-judge-queue evals/rag/generated/judge-queue.json",
    "eval:holdout": "bun --env-file=.env run evals/rag/cli.ts --split holdout",
    "eval:compare": "bun --env-file=.env run evals/rag/cli.ts --compare",
    "eval:studio": "bun --env-file=.env run evals/rag/cli.ts --runner report,flashcards,quiz,mindmap,infographic,spreadsheet,writtenQuestions,audioScript",
    "eval:studio:dry": "bun run evals/rag/cli.ts --dry-run --runner report,flashcards,quiz,mindmap,infographic,spreadsheet,writtenQuestions,audioScript",
    "eval:research": "bun --env-file=.env run evals/rag/cli.ts --runner research",
    "eval:research:dry": "bun run evals/rag/cli.ts --dry-run --runner research",
    "eval:literature-review": "bun --env-file=.env run evals/rag/cli.ts --runner literatureReview",
    "eval:literature-review:dry": "bun run evals/rag/cli.ts --dry-run --runner literatureReview",
    "eval:rag:bootstrap-env": "node scripts/bootstrap-rag-eval-env.js",
    "eval:ragas": "conda run -n solomindlm-rag-evals python evals/ragas/run_ragas.py",
    "e2e:convex:cleanup": "node scripts/cleanup-e2e.mjs",
    "e2e:convex:cleanup-folders": "node scripts/cleanup-e2e-folders.mjs",
    "e2e:convex:cleanup-notebooks": "node scripts/cleanup-e2e-notebooks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "convex": "1.42.3",
    "convex-test": "^0.0.50",
    "dotenv": "^17.4.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@auth/core": "0.37.2",
    "@breezystack/lamejs": "^1.2.7",
    "@convex-dev/action-cache": "^0.3.1",
    "@convex-dev/auth": "^0.0.94",
    "@convex-dev/persistent-text-streaming": "^0.3.3",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/stripe": "^0.1.6",
    "@convex-dev/workflow": "^0.4.4",
    "@convex-dev/workpool": "^0.3.2",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@langchain/textsplitters": "^1.0.1",
    "@oslojs/crypto": "^1.0.1",
    "@standard-schema/spec": "^1.1.0",
    "@supadata/js": "^1.4.0",
    "@tavily/core": "^0.7.6",
    "convex-helpers": "^0.1.120",
    "langsmith": "^0.4.12",
    "p-limit": "^7.3.1",
    "resend": "^4.8.0",
    "stripe": "^20.4.1",
    "together-ai": "^0.39.0",
    "zeroentropy": "^0.1.0-alpha.10",
    "zod": "^4.4.3"
  }
}
