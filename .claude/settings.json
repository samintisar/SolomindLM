  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|mcp__(plugin_serena_)?serena__(replace_symbol_body|insert_before_symbol|insert_after_symbol|replace_content|create_text_file)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/on-edit.mjs format",
            "statusMessage": "Formatting edited file...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/on-edit.mjs typecheck",
            "statusMessage": "Typechecking...",
            "async": true,
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "serena@claude-plugins-official": true
  },
  "prefersReducedMotion": true
}
