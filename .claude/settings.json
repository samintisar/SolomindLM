      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(bun run typecheck:*)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git add)",
      "Bash(git add *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git checkout)",
      "Bash(git checkout *)",
      "Bash(git switch)",
      "Bash(git switch *)",
      "Bash(git push)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "WebSearch",
      "Bash(npx tsc:*)",
      "mcp__ide__getDiagnostics",
      "Bash(npx convex env get:*)",
      "Bash(bun run build)",
      "Bash(npx convex codegen:*)",
      "mcp__plugin_serena_serena__execute_shell_command",
      "mcp__plugin_serena_serena__activate_project",
      "mcp__plugin_serena_serena__onboarding",
      "mcp__plugin_serena_serena__read_file",
      "mcp__plugin_serena_serena__list_dir",
      "mcp__plugin_serena_serena__find_file",
      "mcp__plugin_serena_serena__write_memory",
      "mcp__plugin_serena_serena__list_memories",
      "mcp__plugin_serena_serena__read_memory",
      "mcp__plugin_serena_serena__think_about_collected_information",
      "mcp__plugin_serena_serena__get_current_config",
      "mcp__plugin_serena_serena__check_onboarding_performed",
      "mcp__plugin_serena_serena__create_text_file",
      "mcp__plugin_serena_serena__replace_content",
      "mcp__plugin_serena_serena__think_about_whether_you_are_done",
      "mcp__plugin_serena_serena__initial_instructions",
      "mcp__plugin_serena_serena__search_for_pattern",
      "mcp__plugin_serena_serena__get_symbols_overview",
      "mcp__plugin_serena_serena__think_about_task_adherence",
      "mcp__plugin_serena_serena__find_symbol",
      "mcp__plugin_serena_serena__replace_symbol_body",
      "mcp__plugin_serena_serena__find_referencing_symbols",
      "mcp__plugin_serena_serena__insert_after_symbol",
      "Read(//c/Users/samin/.claude/**)",
      "Read(//c/Users/samin/.claude/plugins/**)",
      "mcp__zai-mcp-server__analyze_image",
      "mcp__plugin_serena_serena__edit_memory",
      "mcp__serena__initial_instructions",
      "mcp__serena__get_current_config",
      "mcp__serena__check_onboarding_performed",
      "mcp__serena__list_memories",
      "mcp__serena__read_memory",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__find_declaration",
      "mcp__serena__find_implementations",
      "mcp__serena__search_for_pattern",
      "mcp__serena__list_dir",
      "mcp__serena__find_file",
      "mcp__serena__read_file",
      "mcp__serena__get_diagnostics_for_file"
    ],
    "deny": [
      "Edit(.env*)",
      "Edit(bun.lock)",
      "Edit(*_generated*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"🔒 SERENA RULE: Read/Edit on .ts/.tsx files are FORBIDDEN for discovery. Use get_symbols_overview -> find_symbol. For edits, use replace_symbol_body or replace_content.\"",
            "if": "Read(*.ts)|Read(*.tsx)|Edit(*.ts)|Edit(*.tsx)",
            "statusMessage": "Serena enforcement reminder",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|mcp__(plugin_serena_)?serena__(replace_symbol_body|insert_before_symbol|insert_after_symbol|replace_content|create_text_file)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/on-edit.mjs format",
            "statusMessage": "Formatting edited file...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/on-edit.mjs typecheck",
            "statusMessage": "Typechecking...",
            "async": true,
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "serena@claude-plugins-official": true
  },
  "prefersReducedMotion": true
}
